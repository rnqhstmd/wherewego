# 환경별 사용법:
#   local: 본 파일을 .env로 복사
#   dev:   EC2의 /etc/wherewego/.env에 배치 (chmod 600), systemd EnvironmentFile
#   prod:  GitHub Actions secrets → 운영 EC2 환경변수 (.env 미사용)
# Supabase port는 5432 (direct connection). 6543 (PgBouncer transaction) 금지

# Spring
SPRING_PROFILES_ACTIVE=local

# DB (Supabase PostgreSQL)
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Redis (local: infra-compose 기준 자동 / dev·prod: 실제 호스트)
REDIS_MASTER_HOST=localhost
REDIS_MASTER_PORT=6379
REDIS_REPLICA_1_HOST=localhost
REDIS_REPLICA_1_PORT=6380

# Kakao OAuth2
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=

# Kakao Local API
KAKAO_LOCAL_API_KEY=

# Google Places API (Phase 5)
GOOGLE_PLACES_API_KEY=

# Mapbox (Phase 6)
MAPBOX_TOKEN=

# JWT
JWT_SECRET=                      # 필수: 32자 이상 랜덤 문자열
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=1209600

# Web Security (Cookie + CORS)
WEB_SECURITY_COOKIE_SECURE=true
WEB_SECURITY_COOKIE_DOMAIN=
WEB_SECURITY_COOKIE_SAME_SITE=None
CORS_ALLOWED_ORIGINS=http://localhost:3000
