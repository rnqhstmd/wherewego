# =============================================================
# wherewego-api 환경변수 예시 파일
# 실제 값을 채운 뒤 backend/.env 로 복사하여 사용한다.
# 이 파일은 git에 커밋된다 (값 없음 / 가이드 전용).
# =============================================================

# Spring
SPRING_PROFILES_ACTIVE=local   # 운영: prod

# DB (Supabase PostgreSQL — Session Pooler, IPv4 호환)
# Supabase 대시보드 > Project Settings > Database > Connection string (Session mode) 에서 확인
POSTGRES_HOST=aws-1-ap-northeast-2.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres.{project-ref}
POSTGRES_PASSWORD=

# JWT
# 최소 32자 이상의 랜덤 문자열. 예: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=1209600

# Kakao OAuth2 (https://developers.kakao.com)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3000/login/callback   # 운영: https://{domain}/login/callback

# Kakao Local API (REST API 키와 동일)
KAKAO_LOCAL_API_KEY=

# Kakao i 오픈빌더 Skill Webhook
KAKAO_SKILL_SECRET=
KAKAO_BOT_ID=

# Google Places API (Phase 5)
GOOGLE_PLACES_API_KEY=

# Google Gemini 2.0 Flash (Phase 2.5)
GEMINI_API_KEY=
GEMINI_ENABLED=true
GEMINI_DAILY_QUOTA_PER_USER=50

# Mapbox (정보용 — 프론트엔드에서 주로 사용)
MAPBOX_TOKEN=

# Web Security (Cookie + CORS)
WEB_SECURITY_COOKIE_SECURE=false    # 운영: true
WEB_SECURITY_COOKIE_DOMAIN=         # 운영: {실제 도메인}
WEB_SECURITY_COOKIE_SAME_SITE=Lax  # 운영: None (cross-site 필요 시)
CORS_ALLOWED_ORIGINS=http://localhost:3000   # 운영: https://{domain}

# Instagram 스크래핑 토글 (장애 시 false로 즉시 비활성화)
INSTAGRAM_SCRAPING_ENABLED=true

# Slack (운영 에러 알림)
SLACK_WEBHOOK_URI=
SLACK_USERNAME=wherewego-dev
SLACK_CHANNEL=#wherewego-alerts
