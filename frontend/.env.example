# ============================================================
# Frontend (Next.js 16) — Environment Variables Example
# 실제 사용 시 .env.local 또는 .env로 복사 후 값 설정.
# ============================================================

# ------------------------------------------------------------
# Backend / BFF
# ------------------------------------------------------------
# Backend API base URL.
# 사용처:
#   - next.config.ts (rewrites/proxy 설정)
#   - src/app/api/[...path]/route.ts (BFF 프록시)
#   - src/app/api/v1/notifications/stream/route.ts (SSE upstream)
#   - src/lib/api/http.ts (서버 사이드 fetch)
BACKEND_BASE_URL=http://localhost:8080

# ------------------------------------------------------------
# Gate (초대 코드 게이트)
# ------------------------------------------------------------
# 게이트 진입에 필요한 초대 코드.
# 사용처: src/lib/auth/gate.ts, src/app/api/auth/gate/route.ts
GATE_INVITE_CODE=

# 게이트 세션 쿠키 서명용 시크릿 (충분히 긴 랜덤 문자열).
# 사용처: src/lib/auth/gate.ts
GATE_COOKIE_SECRET=

# ------------------------------------------------------------
# Mapbox (지도 렌더링)
# ------------------------------------------------------------
# Mapbox GL JS 액세스 토큰 (public 토큰).
# 사용처: src/app/map/page.tsx
NEXT_PUBLIC_MAPBOX_TOKEN=

# (선택) Mapbox 스타일 URL. 미설정 시 기본 스타일 사용.
# 사용처: src/app/map/page.tsx
NEXT_PUBLIC_MAPBOX_STYLE_URL=

# ------------------------------------------------------------
# Kakao 채널
# ------------------------------------------------------------
# 봇 연결 화면에서 노출하는 카카오톡 채널 친구 추가 URL.
# 사용처: src/app/bot/connect/BotConnectClient.tsx
NEXT_PUBLIC_KAKAO_CHANNEL_URL=https://pf.kakao.com/_HxgdsX/friend
